---
import BaseLayout from '../layouts/BaseLayout.astro';
import status from '../data/status.json';

const state = status.backend.state as 'online' | 'degraded' | 'offline';
const headline =
  state === 'online' ? 'All systems operational'
  : state === 'degraded' ? 'Partial outage'
  : 'Backend offline';

const generated = new Date(status.generatedAt);
---
<BaseLayout title="System status · Innocent Onwukanjo" description="Live status of the portfolio infrastructure.">
  <div style="padding-top:36px">
    <span class="eyebrow">Public status</span>
    <h1 style="font-size:clamp(1.8rem,4vw,2.4rem); margin:10px 0 22px">Service health</h1>
  </div>

  <div class="status-banner">
    <span class={`dot lg ${state}`}></span>
    <div>
      <div class="big">{headline}</div>
      <div class="muted" style="font-size:0.92rem">{status.backend.note}</div>
    </div>
  </div>

  <div class="card" style="padding:6px 18px">
    <table class="status-table">
      <thead>
        <tr><th>Service</th><th>State</th><th style="text-align:right">Latency</th></tr>
      </thead>
      <tbody>
        {
          status.services.map((svc) => (
            <tr>
              <td>{svc.name}</td>
              <td><span class={`dot ${svc.state}`}></span> {svc.state}</td>
              <td style="text-align:right; font-family:var(--mono)">
                {svc.latencyMs != null ? `${svc.latencyMs} ms` : 'n/a'}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="muted" style="margin-top:22px; font-size:0.85rem">
    Last updated {generated.toISOString().replace('T', ' ').slice(0, 16)} UTC.
    Refreshed on a schedule by a GitHub Actions probe that writes
    <code>status.json</code> and rebuilds this page.
  </p>
</BaseLayout>
