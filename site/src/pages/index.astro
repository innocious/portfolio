---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Certifications from '../components/Certifications.astro';
import Skills from '../components/Skills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LibraryCTA from '../components/LibraryCTA.astro';
import { site } from '../lib/site';
import { categories } from '../lib/categories';
import { withBase } from '../lib/paths';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Group by primary (first) category; render categories in defined order.
const byCat: Record<string, typeof projects> = {};
for (const p of projects) {
  const primary = p.data.categories[0] ?? 'software';
  (byCat[primary] ??= []).push(p);
}
const activeCats = categories.filter((c) => byCat[c.id]?.length);
const shareUrl = (slug: string) => new URL(withBase(`/projects/${slug}`), Astro.site).href;
---
<BaseLayout title={`${site.name} · ${site.role}`}>
  <Hero />

  <hr class="rule" />

  <section id="about" class="section">
    <div class="section-head">
      <span class="eyebrow">About</span>
      <h2>Who I am</h2>
    </div>
    <p class="muted" style="font-size:1.08rem; text-align: justify;">
      I am a DevOps and platform engineer with more than five years building, automating,
      and running cloud systems. I have shipped and hardened infrastructure and delivery
      pipelines for enterprises like MTN South Africa and Standard Bank, and for
      fast-moving startups, across AWS, Azure, and GCP. My focus is simple: help teams
      ship faster while their systems stay reliable and affordable to run. I am currently
      a student at Memorial University of Newfoundland in Canada.
    </p>
  </section>

  <hr class="rule" />

  <section id="experience" class="section">
    <div class="section-head">
      <span class="eyebrow">Experience</span>
      <h2>Where I have worked</h2>
      <p>Selected roles across enterprise and startup engineering teams.</p>
    </div>
    <Experience />
  </section>

  <hr class="rule" />

  <section id="education" class="section">
    <div class="section-head">
      <span class="eyebrow">Education</span>
      <h2>Where I studied</h2>
    </div>
    <Education />
  </section>

  <hr class="rule" />

  <section id="skills" class="section">
    <div class="section-head">
      <span class="eyebrow">Toolbox</span>
      <h2>Skills and tools</h2>
    </div>
    <Skills />
  </section>

  <hr class="rule" />

  <section id="certifications" class="section">
    <div class="section-head">
      <span class="eyebrow">Credentials</span>
      <h2>Certifications</h2>
    </div>
    <Certifications />
  </section>

  <hr class="rule" />

  <section id="projects" class="section">
    <div class="section-head">
      <span class="eyebrow">Selected work</span>
      <h2>Projects by discipline</h2>
      <p>Organized by the kind of engineering they show. Each project has its own page and a shareable link.</p>
    </div>

    {
      activeCats.map((cat) => (
        <div class="cat-block" id={`cat-${cat.id}`}>
          <div class="cat-block-head">
            <span class="cat-ic"><Icon name={cat.icon} size={20} /></span>
            <h3>{cat.label}</h3>
            <span class="blurb">{cat.blurb}</span>
            <span class="cat-count">{byCat[cat.id].length} project{byCat[cat.id].length > 1 ? 's' : ''}</span>
          </div>
          <div class="grid">
            {byCat[cat.id].map((p) => (
              <ProjectCard
                slug={p.id}
                title={p.data.title}
                summary={p.data.summary}
                stack={p.data.stack}
                categories={p.data.categories}
                shareUrl={shareUrl(p.id)}
                repoUrl={p.data.repoUrl}
              />
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <LibraryCTA />
</BaseLayout>
