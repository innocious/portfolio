---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import { site } from '../lib/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout title={`${site.name} · ${site.role}`}>
  <Hero />

  <hr class="rule" />

  <section id="about" class="section">
    <div class="section-head">
      <span class="eyebrow">About</span>
      <h2>How I work</h2>
    </div>
    <p class="muted" style="max-width:72ch; font-size:1.08rem">
      Most side projects die the moment their single server does. I design the
      opposite: a static surface that is always reachable, a backend allowed to
      come and go, and automation that keeps the two honest with each other. The
      result costs almost nothing to run and stays useful under conditions that
      would take a normal stack offline. Everything you see here, including the
      live status and the free tier it runs on, is built that way on purpose.
    </p>
  </section>

  <hr class="rule" />

  <section id="work" class="section">
    <div class="section-head">
      <span class="eyebrow">Selected work</span>
      <h2>Case studies</h2>
      <p>Representative projects using illustrative data. Each links to a full write-up.</p>
    </div>
    <div class="grid">
      {
        projects.map((p) => (
          <ProjectCard
            slug={p.id}
            title={p.data.title}
            summary={p.data.summary}
            stack={p.data.stack}
            repoUrl={p.data.repoUrl}
          />
        ))
      }
    </div>
  </section>

  <hr class="rule" />

  <section id="skills" class="section">
    <div class="section-head">
      <span class="eyebrow">Toolbox</span>
      <h2>Skills and tools</h2>
    </div>
    <Skills />
  </section>
</BaseLayout>
